# Keep the documented example env files, and the production build-flag file
# (no secrets in either — just non-sensitive config), even though `.env.*`
# is ignored above.
!.env.example
!frontend/.env.production

# Runtime data and tool artefacts (never commit)
backend/backups/
backend/uploads/
.playwright-mcp/
