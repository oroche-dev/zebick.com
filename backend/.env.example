# Copy to .env and fill in real values. Never commit the real .env (already
# covered by .gitignore: .env, .env.*, *.env).

# --- MongoDB (required) ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=zebick

# --- Security (required in production) ---
# Fails startup if missing/short when ENFORCE_STRICT_SECURITY=true.
# Generate JWT_SECRET and ADMIN_PASSWORD_HASH together: python -m scripts.gen_secrets
JWT_SECRET=
JWT_EXPIRATION_HOURS=2
ENFORCE_STRICT_SECURITY=true

# Comma-separated list of allowed frontend origins, e.g.:
#   CORS_ORIGINS=https://zebick.com,https://www.zebick.com
# Leave unset only for local dev — credentialed CORS is disabled automatically
# whenever this falls back to "*".
CORS_ORIGINS=

# Seeds the first superadmin on an empty DB (hash from python -m scripts.gen_secrets).
ADMIN_EMAIL=admin@zebick.com
ADMIN_PASSWORD_HASH=

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

# --- Public URLs (used in offer-tracking links / emails) ---
PUBLIC_SITE_URL=https://www.zebick.com
PUBLIC_BACKEND_URL=https://api.zebick.com

# --- Email (transactional + newsletter) ---
# All three below send over HTTPS — work on hosts that block outbound SMTP
# ports (e.g. Render). Checked in order: Gmail API, then Resend, then plain
# SMTP as a last resort. When any is set, the ones below it are ignored.
# 1) Gmail API — sends as your own Google/Workspace address. See
#    docs/email-gmail-api-setup.md (generate with `python -m scripts.gmail_oauth_setup`).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# 2) Resend. See docs/email-resend-setup.md.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Zebick
# true = log emails instead of sending (local dev, only used when none of the above are set)
SMTP_MOCK=false
ADMIN_NOTIFICATION_EMAIL=
# Where contact-form submissions with Service="Support (bestehendes Projekt)"
# get routed instead. Leave unset to just use ADMIN_NOTIFICATION_EMAIL for those too.
SUPPORT_NOTIFICATION_EMAIL=

# --- IMAP (admin inbox sync, optional) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# --- Cloudflare R2 (optional, S3-compatible object storage) ---
# Used for (a) offsite backup copies and (b) blog/portfolio image uploads —
# see docs/object-storage-setup.md. Leave all unset to keep backups on local
# disk (backend/backups) and image uploads on local disk (backend/uploads).
# BACKUP_DIR=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET=
# Public base URL where bucket objects are reachable (R2.dev dev subdomain
# or your own domain mapped to the bucket). Only needed for image uploads,
# not for backups. Required together with the 4 vars above to activate R2
# uploads — e.g. https://pub-xxxxxxxx.r2.dev or https://cdn.zebick.com
R2_PUBLIC_URL=

# --- Chatbot (OpenAI-compatible, optional — falls back to a static reply if unset) ---
LLM_API_KEY=

# --- Google Analytics (optional, admin dashboard) ---
# Also requires backend/ga_credentials.json (a GCP service account key with
# Viewer access on the GA4 property) — see docs/google-analytics-setup.md.
GA_PROPERTY_ID=

# --- PageSpeed Insights (required for the real URL-audit tool) ---
# Free key from console.cloud.google.com: enable "PageSpeed Insights API",
# then Anmeldedaten > API-Schlüssel. No billing required. The keyless tier
# has a hard 0 requests/day quota, so this is not optional.
PAGESPEED_API_KEY=

# --- Dev-only flags ---
# false = disable API rate limits (only honoured when ENFORCE_STRICT_SECURITY=false; for local test runs).
RATE_LIMIT_ENABLED=true
# Overwrites DB-stored email templates with the built-in defaults on startup.
RESEED_EMAIL_TEMPLATES=false

# --- Tests only (backend/tests reads these via conftest.py; git-ignored here) ---
# Credentials of an admin that exists in the database the tests run against.
TEST_ADMIN_EMAIL=admin@zebick.com
TEST_ADMIN_PASSWORD=
# Base URL of the running backend the tests talk to.
REACT_APP_BACKEND_URL=http://localhost:8001
